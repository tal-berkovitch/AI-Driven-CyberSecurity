# Streaming transport spine: kafka (demo default) | file (offline/test fallback).
# Both implement the same Producer/Consumer interface; control plane stays file-based.
TRANSPORT=kafka
KAFKA_BOOTSTRAP=kafka:9092

# Detection backend: local | isolation_forest | morpheus
DETECTOR_BACKEND=local

# Defender mode: record (consume->features->baseline CSV) | detect (live scoring->alerts)
DEFENDER_MODE=record
# Skip the queue backlog on startup so a restart starts live (true) instead of
# replaying/re-alerting old captures. Set false to process the existing backlog.
SEEK_TO_END=true

# Attacker traffic: benign | all | comma-list of dns_tunnel,snmp_recon,snmp_amplify
ATTACK_MODE=benign
# Attack cadence: mixed (organic waves, randomized per run — best for the live demo)
# | loud | slow (force a fixed intensity, e.g. for reproducible captures)
ATTACK_INTENSITY=mixed

# Groq for the CTI worker (AG2 multi-agent) + the UI situation summary — both run
# OFF the isolated net. Empty -> deterministic offline template + summary.
GROQ_API_KEY=
# 8b-instant fits the Groq free tier (12k TPM); 70b-versatile gives richer reports
# but needs a paid/dev tier or it will hit 429 rate limits under load.
GROQ_MODEL=llama-3.1-8b-instant
# At most one AG2 LLM report per N seconds (loud bursts reuse the offline template),
# so a free-tier token budget isn't exhausted. 0 disables the throttle.
CTI_LLM_COOLDOWN_SECONDS=12

# SOC dashboard (FastAPI+SSE) host port (open http://localhost:<UI_PORT>)
UI_PORT=8000
# How often the LLM situation-summary panel refreshes (seconds), and how many
# recent alerts feed the (fixed-size) summary prompt.
SUMMARY_INTERVAL=25
SUMMARY_LAST_K=15

# Shared control plane dir (UI writes model/restart requests; ops-agent + defender read).
CONTROL_DIR=/app/control

# Logging
LOG_LEVEL=INFO
