# Detection backend: local | isolation_forest | morpheus
DETECTOR_BACKEND=local

# Defender mode: record (consume->features->baseline CSV) | detect (live scoring->alerts)
DEFENDER_MODE=record

# Attacker traffic: benign | all | comma-list of dns_tunnel,snmp_recon,snmp_amplify
ATTACK_MODE=benign
ATTACK_INTENSITY=loud

# Groq for the CTI worker (AG2 multi-agent) + the UI analyst chat — both run OFF
# the isolated net. Empty -> deterministic offline template + chat disabled.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# SOC dashboard (FastAPI+SSE) host port (open http://localhost:<UI_PORT>)
UI_PORT=8000
# How often the LLM situation-summary panel refreshes (seconds), and how many
# recent alerts feed the (fixed-size) summary prompt.
SUMMARY_INTERVAL=25
SUMMARY_LAST_K=15

# Logging
LOG_LEVEL=INFO
