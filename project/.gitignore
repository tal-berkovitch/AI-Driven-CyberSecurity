# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/

# Environment / secrets
.env

# Data & artifacts (keep dir structure via .gitkeep)
data/queue/*
data/baseline/*
data/eval/*
data/real/*
data/reports/*
data/model_card.json
models/*
!**/.gitkeep

# Runtime control plane (UI<->ops-agent<->defender): health, model/backend selection
/control/

# Eval outputs are regenerated by `python -m eval.run_eval`
eval/report/*
!eval/report/.gitkeep

# Local Claude Code tooling state (plans, settings) — not project code
.claude/

# Logs / misc
*.log
