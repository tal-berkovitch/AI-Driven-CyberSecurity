# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/

# Environment / secrets
.env

# Data & artifacts (keep dir structure via .gitkeep)
data/queue/*
data/baseline/*
data/eval/*
data/real/*
models/*
!**/.gitkeep

# Eval outputs are regenerated by `python -m eval.run_eval`
eval/report/*
!eval/report/.gitkeep

# Logs / misc
*.log
